pkgname=xlibre-input-libinput
_pkgname=xf86-input-libinput
pkgver=25.0.2rc1
pkgrel=1
pkgdesc="Generic input driver for the XLibre Xserver based on libinput"
arch=('x86_64')
license=('MIT')
url='https://github.com/X11Libre/xf86-input-libinput'
depends=(
	'glibc'
	'libinput'
	'xlibre-xserver'
)
makedepends=(
	'libx11'
	'libxi'
	'meson'
	'X-ABI-XINPUT_VERSION=26.0'
	'xlibre-xserver-devel'
)
provides=('xf86-input-libinput')
conflicts=(
	'X-ABI-XINPUT_VERSION<26'
	'X-ABI-XINPUT_VERSION>=27'
	'xf86-input-libinput'
)
groups=('xlibre-drivers')

_srcver=${pkgver/rc/-rc}

source=("${url}/archive/refs/tags/xlibre-${_pkgname}-${_srcver}.tar.gz")
sha512sums=('7d886efdaac5cefffb90243389c7cb1e722e33c720bf173b2475be054fd81983970ac49616e5f30b480049866d147612dcff7e010164ece745427a125051e7d5')

build() {
	arch-meson "$_pkgname-xlibre-$_pkgname-$_srcver" build \
		-D xorg-conf-dir=/usr/share/X11/xorg.conf.d/

	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
