build() {
	# Since pacman 5.0.2-2, hardened flags are now enabled in makepkg.conf
	# With them, modules fail to load with undefined symbol.
	# See https://bugs.archlinux.org/task/55102 / https://bugs.archlinux.org/task/54845
	export CFLAGS=${CFLAGS/-fno-plt}
	export CXXFLAGS=${CXXFLAGS/-fno-plt}
	export LDFLAGS=${LDFLAGS/-Wl,-z,now}

	local systemd_notify=false
	((USE_SYSTEMD)) && systemd_notify=true

	arch-meson "$_S" build \
		-D xephyr=true \
		-D xfbdev=true \
		-D xnest=true \
		-D xorg=true \
		-D xvfb=true \
		-D dri1=true \
		-D dri2=true \
		-D dri3=true \
		-D dtrace=false \
		-D gbm=true \
		-D glamor=true \
		-D glx_dri=true \
		-D ipv6=true \
		-D legacy_nvidia_340x=true \
		-D legacy_nvidia_padding=true \
		-D libunwind=true \
		-D linux_acpi=false \
		-D mitshm=true \
		-D seatd_libseat=false \
		-D suid_wrapper=true \
		-D systemd_logind=true \
		-D systemd_notify="$systemd_notify" \
		-D udev=true \
		-D udev_kms=true \
		-D xcsecurity=true \
		-D xkb_dir=/usr/share/X11/xkb \
		-D xkb_output_dir=/var/lib/xkb

	# Print config
	meson configure build
	ninja -C build

	# fake installation to be separated into packages
	DESTDIR="${srcdir}/_" ninja -C build install
}

_install() {
	local src dest

	for src; do
		dest=${src#_/}
		install -d "$pkgdir/${dest%/*}"
		cp -av "$src" "$pkgdir/$dest" || return
		rm -rf "$src" || return
	done
}

package_xlibre-xserver-common-beta() {
	pkgdesc="XLibre server common files"
	depends=(
		'xkeyboard-config'
		'xorg-setxkbmap'
		'xorg-xkbcomp'
	)
	optdepends=()
	provides=(
		'xlibre-xserver-common'
		'xorg-server-common'
	)
	conflicts=(
		'xlibre-xserver-common'
		'xorg-server-common'
	)
	replaces=('xlibre-xserver-common>=25.2.0')

	_install _/usr/lib/xorg/protocol.txt
	_install _/usr/share/man/man1/Xserver.1

	install -m644 -Dt "${pkgdir}/usr/share/licenses/${pkgname}" "$_S"/COPYING
}

package_xlibre-xserver-beta() {
	pkgdesc="XLibre Xserver"
	depends+=(
		'dbus'
		'glibc'
		'libbsd'
		'libdrm'
		'libepoxy'
		'libgl'
		'libpciaccess'
		'libtirpc'
		'libunwind'
		'libudev.so'
		'libxau'
		'libxcvt' # FS#52949
		'libxdmcp'
		'libxfont2'
		'libxshmfence'
		'nettle'
		'pixman'
		'sh'
		'xlibre-xserver-common-beta'
	)
	# see xorg-server-*/hw/xfree86/common/xf86Module.h for ABI versions - we provide major numbers
	# that drivers can depend on and /usr/lib/pkgconfig/xorg-server.pc in xorg-server-devel pkg
	provides=(
		'X-ABI-EXTENSION_VERSION=11.0'
		'X-ABI-VIDEODRV_VERSION=28.0'
		'X-ABI-XINPUT_VERSION=26.0'
		'x-server'
		'xlibre-xserver'
		'xorg-server'
	)
	provides+=('x11win-server') # Artix only
	conflicts=(
		'glamor-egl'
		'nvidia-utils<=331.20'
		'xf86-video-modesetting'
		'xlibre-xserver'
		'xorg-server'
	)
	replaces=(
		'glamor-egl'
		'xf86-video-modesetting'
		'xlibre-xserver>=25.2.0'
	)

	_install _/usr/bin/gtf
	_install _/usr/bin/X
	_install _/usr/bin/Xfbdev
	_install _/usr/bin/Xorg
	_install _/usr/lib/Xorg
	_install _/usr/lib/Xorg.wrap
	_install _/usr/lib/xorg/modules/*
	_install _/usr/share/X11/xorg.conf.d/10-nvidia.conf
	_install _/usr/share/X11/xorg.conf.d/10-nvidia-modules.conf
	_install _/usr/share/X11/xorg.conf.d/10-quirks.conf
	_install _/usr/share/man/man1/gtf.1
	_install _/usr/share/man/man1/Xfbdev.1
	_install _/usr/share/man/man1/Xkdrive.1
	_install _/usr/share/man/man1/Xorg.1
	_install _/usr/share/man/man1/Xorg.wrap.1
	_install _/usr/share/man/man4/exa.4
	_install _/usr/share/man/man4/fbdevhw.4
	_install _/usr/share/man/man4/inputtestdrv.4
	_install _/usr/share/man/man4/modesetting.4
	_install _/usr/share/man/man5/Xwrapper.config.5
	_install _/usr/share/man/man5/xorg.conf.5
	_install _/usr/share/man/man5/xorg.conf.d.5

	# distro specific files must be installed in /usr/share/X11/xorg.conf.d
	install -m755 -d "${pkgdir}/etc/X11/xorg.conf.d"

	install -m644 -Dt "${pkgdir}/usr/share/licenses/${pkgname}" "$_S"/COPYING
}

