package_xlibre-xserver-xvfb-beta() {
	pkgdesc="Virtual framebuffer X server"
	# xvfb-run is GPLv2, rest is MIT
	license=(
		'GPL-2.0-only'
		'MIT'
	)
	depends+=(
		'glibc'
		'libgl'
		'libtirpc'
		'libunwind'
		'libxau'
		'libxdmcp'
		'libxfont2'
		'nettle'
		'pixman'
		'sh'
		'xlibre-xserver-common-beta'
		'xorg-xauth'
	)
	optdepends=()
	provides=(
		'xlibre-xserver-xvfb'
		'xorg-server-xvfb'
	)
	conflicts=(
		'xlibre-xserver-xvfb'
		'xorg-server-xvfb'
	)
	replaces=('xlibre-xserver-xvfb>=25.2.0')

	_install _/usr/bin/Xvfb
	_install _/usr/share/man/man1/Xvfb.1

	install -m755 "${srcdir}/xvfb-run" "${pkgdir}/usr/bin/"
	install -m644 "${srcdir}/xvfb-run.1" "${pkgdir}/usr/share/man/man1/"
	install -m644 -Dt "${pkgdir}/usr/share/licenses/${pkgname}" "$_S"/COPYING
}

