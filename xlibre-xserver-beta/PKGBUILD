package_xlibre-xserver-devel-beta() {
	pkgdesc="Development files for the XLibre Xserver"
	depends=(
		'libpciaccess'
		'mesa'
		'pixman'
		'xlibre-xserver-beta'
		'xorg-util-macros' # not required but almost every XLibre pkg needs it
		'xorgproto'
	)
	optdepends=()
	provides=(
		'xlibre-xserver-devel'
		'xorg-server-devel'
	)
	conflicts=(
		'xlibre-xserver-devel'
		'xorg-server-devel'
	)
	replaces=('xlibre-xserver-devel>=25.2.0')

	_install _/usr/include/xorg/*
	_install _/usr/lib/pkgconfig/*
	_install _/usr/share/aclocal/*
	_install _/usr/share/xorg-server/abi/*

	# license
	install -m644 -Dt "${pkgdir}/usr/share/licenses/${pkgname}" "$_S"/COPYING

	# make sure there are no files left to install
	rm _/etc/X11/xorg.conf.d/10-nvidia-modules.conf.debian
	rm _/etc/X11/xorg.conf.d/10-nvidia.conf.debian
	find _ -depth -print0 | xargs -0 rmdir
}
