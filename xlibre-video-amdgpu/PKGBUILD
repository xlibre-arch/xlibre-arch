pkgname=xlibre-video-amdgpu
_pkgname=xf86-video-amdgpu
pkgver=25.1.3rc1
pkgrel=1
pkgdesc="XLibre amdgpu video driver"
arch=('x86_64')
url='https://github.com/X11Libre/xf86-video-amdgpu'
license=('MIT')
depends=(
	'glibc'
	'libdrm'
	'mesa'
	'libudev.so'
	'xlibre-xserver'
)
makedepends=(
	'meson'
	'X-ABI-VIDEODRV_VERSION=28.0'
	'xlibre-xserver-devel'
)
provides=('xf86-video-amdgpu')
conflicts=(
	'X-ABI-VIDEODRV_VERSION<28'
	'X-ABI-VIDEODRV_VERSION>=29'
	'xf86-video-amdgpu'
)
groups=('xlibre-drivers')

_srcver=${pkgver/rc/-rc}
_S=$_pkgname-xlibre-$_pkgname-$_srcver

source=("${url}/archive/refs/tags/xlibre-${_pkgname}-${_srcver}.tar.gz")
sha512sums=('20378b5e17700991fee308946fbcfe89330e7ef7e22fd9fbb95695015a9640e56bd6e46fe5dc6f659a7c5fcf85fda38b5a08fe5ac3e071761012669b1f6abaad')

build() {
	# Since pacman 5.0.2-2, hardened flags are now enabled in makepkg.conf
	# With them, module fail to load with undefined symbol.
	# See https://bugs.archlinux.org/task/55102 / https://bugs.archlinux.org/task/54845
	export CFLAGS=${CFLAGS/-fno-plt}
	export CXXFLAGS=${CXXFLAGS/-fno-plt}
	export LDFLAGS=${LDFLAGS/-Wl,-z,now}

	arch-meson "$_S" build \
		-D glamor=enabled

	# Print config
	meson configure build

	meson compile -C build
}

check() {
	meson test -C build --print-errorlogs
}

package() {
	meson install -C build --destdir "$pkgdir"
	install -Dvm644 "$_S"/COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
